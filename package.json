{
  "name": "untitled-island-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:short": "playwright test e2e/m1-slice.spec.ts e2e/m2-production.spec.ts",
    "simulate": "tsx scripts/simulate.ts",
    "simulate:ci": "tsx scripts/simulate.ts --batch=matrix --runs=1 --seed=ci",
    "simulate:release": "tsx scripts/simulate.ts --batch=release",
    "simulate:sensitivity": "tsx scripts/simulate.ts --batch=sensitivity"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "prettier": "latest",
    "tsx": "latest",
    "typescript-eslint": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
